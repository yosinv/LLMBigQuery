# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: use Claude on AWS Bedrock instead (uses your AWS credentials)
# LLM_PROVIDER=bedrock
# LLM_MODEL=<bedrock model id>
LLM_MODEL=claude-sonnet-5-5
# GCP project billed for queries. Auth: `gcloud auth application-default login`
GCP_PROJECT=
MAX_GB_PER_QUERY=2
